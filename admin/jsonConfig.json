        "_options": {
            "type": "panel",
            "label": "Options",
            "icon": "data:image/svg+xml;base64,",
            "items": {
                "_headerOptionsDiscovery": {
                    "newLine": true,
                    "type": "header",
                    "text": "Device discovery",
                    "size": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "multicastAddr": {
                    "type": "text",
                    "xs": 12,
                    "sm": 12,
                    "md": 5,
                    "lg": 5,
                    "xl": 5,
                    "label": "Broadcast Address",
                    "help": "Leave empty to search on all network interfaces"
                },
                "port": {
                    "type": "number",
                    "xs": 12,
                    "sm": 12,
                    "md": 5,
                    "lg": 5,
                    "xl": 5,
                    "label": "Port",
                    "help": "Default Port is 56747"
                },
                "_startWizard": {
                    "type": "sendTo",
                    "command": "wizard",
                    "jsonData": "{\"multicastAddr\": \"${data.multicastAddr}\", \"port\": ${data.port}}",
                    "icon": "search",
                    "variant": "contained",
                    "showProcess": true,
                    "useNative": true,
                    "xs": 12,
                    "sm": 2,
                    "md": 2,
                    "lg": 2,
                    "xl": 2,
                    "label": "Search devices"
                },
                "_headerOptionsConnection": {
                    "newLine": true,
                    "type": "header",
                    "text": "Device connection",
                    "size": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "host": {
                    "newLine": true,
                    "type": "text",
                    "xs": 12,
                    "sm": 12,
                    "md": 5,
                    "lg": 5,
                    "xl": 5,
                    "label": "IP-Adress / Hostname",
                    "help": "IP or hostname of your Zehnder ComfoConnect LAN C"
                },
                "uuid": {
                    "type": "text",
                    "xs": 12,
                    "sm": 12,
                    "md": 5,
                    "lg": 5,
                    "xl": 5,
                    "label": "UUID",
                    "help": "UUID of your Zehnder ComfoConnect LAN C"
                },
                "pin": {
                    "type": "text",
                    "xs": 12,
                    "sm": 12,
                    "md": 2,
                    "lg": 2,
                    "xl": 2,
                    "label": "PIN",
                    "help": "Default PIN is 0000 (can be changed in the app)"
                },
                "_headerOptionsSupport": {
                    "newLine": true,
                    "type": "header",
                    "text": "Support this project",
                    "size": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
